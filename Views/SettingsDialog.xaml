<Window x:Class="Hanime1Downloader.CSharp.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="600"
        Height="640"
        MinWidth="560"
        MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource ThemeDialogBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="118"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
        </Style>
        <Style x:Key="FormRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="FormHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="118,0,0,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMutedBrush}"/>
        </Style>
        <Style x:Key="FormCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片式分组：标题条 + 内容区 -->
        <Style x:Key="SectionGroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource ThemeSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <Border Padding="12,8"
                                        Background="{DynamicResource ThemeSurfaceSubtleBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="5,5,0,0">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                </Border>
                                <ContentPresenter Margin="12,10,12,12"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,3,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ThemeSurfaceSubtleBrush}"
                                BorderBrush="{DynamicResource ThemeBorderChromeBrush}"
                                BorderThickness="1"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,14,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="设置"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
            <TextBlock Text="下载、界面与详情面板的偏好设置"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource ThemeTextMutedBrush}"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SettingsTabItemStyle}"/>
            </TabControl.Resources>

            <TabItem Header="下载">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,0">
                    <StackPanel>
                        <GroupBox Header="下载行为" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="默认画质:"/>
                                    <ComboBox x:Name="QualityCombo" Height="30" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="同时下载任务:"/>
                                    <ComboBox x:Name="MaxConcurrentDownloadsCombo" Height="30" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="失败重试次数:"/>
                                    <ComboBox x:Name="MaxRetriesCombo" Height="30" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </DockPanel>
                                <CheckBox x:Name="PersistQueueCheckBox"
                                          Style="{StaticResource FormCheckBoxStyle}"
                                          Margin="0,2,0,0"
                                          Content="关闭程序后保留下载队列"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="文件管理" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="保存路径:"/>
                                    <Button DockPanel.Dock="Right"
                                            Width="76"
                                            Margin="8,0,0,0"
                                            Click="BrowseButton_OnClick"
                                            Content="浏览..."
                                            Style="{StaticResource DialogButtonStyle}"/>
                                    <TextBox x:Name="DownloadPathBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" TextChanged="DownloadPathBox_OnTextChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="DownloadPathHintText" Style="{StaticResource FormHintStyle}"/>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="命名规则:"/>
                                    <ComboBox x:Name="NamingRuleCombo" Height="30" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="NamingRuleCombo_OnSelectionChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="NamingPreviewText" Style="{StaticResource FormHintStyle}" Margin="118,0,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="站点" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="访问站点:"/>
                                    <ComboBox x:Name="SiteCombo" Height="30" SelectedValuePath="Value" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="SiteCombo_OnSelectionChanged" LostFocus="SiteCombo_OnEditChanged" KeyUp="SiteCombo_OnEditChanged">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                                                    <Button x:Name="DeleteSiteButton"
                                                            Grid.Column="1"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="6,0,0,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed"
                                                            Click="SiteOptionDeleteButton_OnClick"
                                                            Tag="{Binding Value}"
                                                            Content="×"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            ToolTip="删除该自定义站点"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                        <Setter TargetName="DeleteSiteButton" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="SiteHintText" Style="{StaticResource FormHintStyle}" Margin="118,0,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="界面">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,0">
                    <StackPanel>
                        <GroupBox Header="显示选项" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="界面主题:"/>
                                    <ComboBox x:Name="ThemeModeCombo" Height="30" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                </DockPanel>
                                <CheckBox x:Name="ShowListCoversCheckBox"
                                          Style="{StaticResource FormCheckBoxStyle}"
                                          Content="在列表中显示视频封面"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="关于" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel>
                                <DockPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="当前版本:"/>
                                    <TextBlock x:Name="VersionText"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource ThemeTextBrush}"/>
                                </DockPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="版本更新:"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdateButton"
                                                Width="96"
                                                Content="检查更新"
                                                Click="CheckUpdateButton_OnClick"
                                                Style="{StaticResource DialogButtonStyle}"/>
                                        <TextBlock x:Name="UpdateStatusText"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="详情面板">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,0">
                    <StackPanel>
                        <GroupBox Header="详情面板显示项" Style="{StaticResource SectionGroupStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <CheckBox x:Name="ShowTitleCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="标题"/>
                                    <CheckBox x:Name="ShowUploadDateCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="上传日期"/>
                                    <CheckBox x:Name="ShowLikesCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="点赞"/>
                                    <CheckBox x:Name="ShowViewsCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="观看次数"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="ShowDurationCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="时长"/>
                                    <CheckBox x:Name="ShowTagsCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="标签"/>
                                    <CheckBox x:Name="ShowCoverCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="封面（查看按钮）"/>
                                    <CheckBox x:Name="ShowRelatedVideosCheckBox" Style="{StaticResource FormCheckBoxStyle}" Content="相关视频"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="-14,12,-14,0"
                Padding="14,10"
                Background="{DynamicResource ThemeSurfaceFooterBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                           Text="修改后点击「保存设置」生效"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="104"
                            IsDefault="True"
                            Click="ConfirmButton_OnClick"
                            Content="保存设置"
                            Style="{StaticResource DialogButtonStyle}"
                            Background="{DynamicResource ThemeAccentBrush}"
                            Foreground="{DynamicResource ThemeAccentForegroundBrush}"
                            BorderBrush="{DynamicResource ThemeAccentBrush}"/>
                    <Button Width="82"
                            Margin="8,0,0,0"
                            IsCancel="True"
                            Content="取消"
                            Style="{StaticResource DialogButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
